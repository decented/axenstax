<?xml version="1.0" encoding="utf-8"?>
<!--
  Axe'n'Stax Android APK manifest.

  android:hasCode="true"    — the APK carries one tiny Java class, AxenstaxActivity
                              (java/com/axenstax/game/), compiled to classes.dex by
                              build-apk.sh with javac + d8. No Gradle. The game
                              itself is still libaxenstax_engine.so.
  AxenstaxActivity          — a NativeActivity subclass whose only job is
                              onNewIntent -> setIntent. Stock NativeActivity drops
                              onNewIntent, so a link tapped while the game runs
                              would leave getIntent() on the launch intent.
  launchMode="singleTask"   — one game instance: tapping an axenstax: link while the
                              game runs brings it forward and delivers onNewIntent
                              rather than starting a second copy.
  VIEW filters              — axenstax: links open the game: axenstax://keep/...
                              (a Keep invite, the case this is for) and the other
                              axenstax:// forms (a friend invite, a server). The
                              engine reads getIntent().getDataString() over JNI
                              (src/launch_links.rs) and routes the text as Join
                              Game does. The scheme-only filter already matches
                              every axenstax: URL; the host=keep one names the
                              Keep links so they stay claimed if it is narrowed.
  android.app.lib_name      — NativeActivity dlopen()s "libaxenstax_engine.so"
                              from this value and calls `android_main`. MUST
                              match [lib] name in game/engine/Cargo.toml.
  Theme.NoTitleBar.Fullscreen
                            — without it NativeActivity gets a title bar and
                              status bar over the game.
  configChanges             — swallow rotation/resize/keyboard changes instead
                              of letting Android destroy and recreate the
                              Activity, which would tear down the wgpu surface
                              and the whole world with it.
  android:icon              — Copperline launcher icon from res/ (adaptive on API 26+,
                              legacy PNG on 24-25). Regenerate with
                              `node brand/render-rasters.mjs`. res/ is compiled by
                              build-apk.sh (aapt2 compile) — no Gradle needed.
  INTERNET                  — multiplayer (QUIC/WebSocket), the Nostr relay for
                              sign-in, and the feedback mailbox. Nothing else is
                              requested: no storage permission is needed because
                              saves live in internal_data_path(), and no
                              location/camera/contacts are used at all.
  enableOnBackInvokedCallback="false"
                            — REQUIRED while we target SDK 36. Apps targeting 36
                              on an Android 16+ device get predictive back by
                              default, and then KEYCODE_BACK is no longer
                              dispatched to the app at all: the system simply
                              finishes the Activity, which quit the game
                              mid-world. Opting out restores the key-event path
                              that lib.rs folds onto Escape (layered close).
                              The real migration is OnBackInvokedDispatcher, which
                              needs JNI, so it waits until android-activity exposes it.
                              See developer.android.com/about/versions/16/behavior-changes-16.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.axenstax.game">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No Auto Backup: identity, runtime and burner keys live in app files and must not leave the device. -->
    <application
        android:allowBackup="false"
        android:label="Axe'n'Stax"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true">

        <activity
            android:name=".AxenstaxActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="Axe'n'Stax"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|smallestScreenSize|uiMode">

            <meta-data
                android:name="android.app.lib_name"
                android:value="axenstax_engine" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Any axenstax: link: a Keep invite, a friend invite, a server address. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="axenstax" />
            </intent-filter>

            <!-- Keep invite: axenstax://keep/<host key>/<secret>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="axenstax" android:host="keep" />
            </intent-filter>
        </activity>
    </application>
</manifest>
