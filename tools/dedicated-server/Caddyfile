# Axe'n'Stax dedicated server front (in-container).
#
# One HTTPS origin on :8443 serves the web client AND the game socket, so the
# browser trusts the self-signed cert once and reuses it for wss. The cert is
# generated by entrypoint.sh into /certs (SAN localhost+127.0.0.1; LAN testers
# click through the warning for the box's IP — unavoidable without a real domain).

{
	# No public domain → no ACME. We supply our own self-signed cert below.
	auto_https off
	admin off

	# Force HTTP/1.1. The engine's game socket is a plain HTTP/1.1 WebSocket, but
	# when the page is served over HTTP/2 (default ALPN), Chromium/Brave opens the
	# game WebSocket over HTTP/2 (RFC 8441 Extended CONNECT). reverse_proxy can't
	# bridge that to the h1 backend → 502, and the web client hangs forever on the
	# loading screen ("Connecting to server…"). A single WASM bundle gains nothing
	# from h2 multiplexing, so pin h1.1 and keep the WebSocket Upgrade rock-solid.
	servers {
		protocols h1
	}
}

:8443 {
	tls /certs/server.crt /certs/server.key

	# Game socket → the engine's plain WebSocket on localhost. `reverse_proxy`
	# transparently upgrades the WebSocket connection.
	handle /ws {
		reverse_proxy 127.0.0.1:6767
	}

	# Operator Console (web sidecar) → the console service on the compose network.
	# `handle_path` strips /admin; the console sets <base href> to /admin/. Only the
	# operator npub can sign in (see tools/sites/console).
	redir /admin /admin/
	handle_path /admin/* {
		reverse_proxy axenstax-console:8101
	}

	# Live showcase/kiosk config — written by the Operator Console (World/Showcase
	# panel) into the identity dir; the dedicated page fetches it at boot to arm or
	# disarm the kiosk without a rebuild. Exact-match so it can't shadow other paths.
	handle /showcase.json {
		root * /worlds/.identity
		file_server
	}

	# Creator Gallery exhibit images (Spec 2026-06-19 §9). The artist drops
	# `<world>/exhibits/*.png|jpg` onto the worlds volume; the web kiosk fetches
	# them same-origin (`/exhibits/<ref>`). `handle_path` strips the prefix and
	# serves from the SERVED world's folder — `$AXENSTAX_WORLD` (default
	# `server-world`) under `/worlds`. A missing file 404s and the client skips
	# that exhibit (the engine guards it). Must precede the catch-all below.
	handle_path /exhibits/* {
		root * /worlds/{$AXENSTAX_WORLD:server-world}/exhibits
		# Artist-dropped files: never sniff them into HTML/script, never run
		# anything they contain.
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
		file_server
		encode zstd gzip
	}

	# Web client (guest-boot PWA) for everything else.
	handle {
		root * /srv/web
		file_server
		encode zstd gzip
	}
}
