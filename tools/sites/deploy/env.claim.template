# Axe'n'Stax — CLAIM site production env. Copy to /opt/axenstax/tools/sites/claim/.env
# Serves claim.axenstax.com — merch fulfilment intake. Code-gated, NO payment
# (buyer pays you in person; the code is proof). NEVER commit a filled .env.
PORT=8100
# Printful PRIVATE token (Developer Portal → API). REQUIRED to accept orders.
# Blank = the page shows "not open yet" and creates no orders (safe default).
PRINTFUL_TOKEN=
# Only needed if your token is account-level (multiple stores). Else leave blank.
PRINTFUL_STORE_ID=
# false (default) = create DRAFT orders — Printful neither charges nor ships until
# you confirm in its dashboard (safe). true = auto-confirm/fulfil on submit.
PRINTFUL_AUTO_CONFIRM=false
# "Back to Axe'n'Stax" link target.
MARKETING_URL=https://axenstax.com
# Base used by gen_codes.py when printing claim URLs / QR cards.
CLAIM_URL_BASE=https://claim.axenstax.com
