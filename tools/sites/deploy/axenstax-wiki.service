[Unit]
Description=Axe'n'Stax — wiki site (player reference, FastAPI/uvicorn :8097)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/axenstax/tools/sites/wiki
EnvironmentFile=/opt/axenstax/tools/sites/wiki/.env
ExecStart=/opt/axenstax/tools/sites/wiki/.venv/bin/python app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
