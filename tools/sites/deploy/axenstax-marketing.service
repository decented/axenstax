[Unit]
Description=Axe'n'Stax — marketing site (public landing, FastAPI/uvicorn :8096)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/axenstax/tools/sites/marketing
EnvironmentFile=/opt/axenstax/tools/sites/marketing/.env
ExecStart=/opt/axenstax/tools/sites/marketing/.venv/bin/python app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
