# Axe'n'Stax — GAME site production env. Copy to /opt/axenstax/tools/sites/game/.env
# on the host. NEVER commit a filled .env. No live secrets belong in this template;
# NOSTR_SERVER_KEY is generated on the host. The dev .env (with the live GROQ key)
# must NEVER be copied to a public host.
# Serves play.axenstax.com (the PWA runtime).
PORT=8094
GAME_URL=https://play.axenstax.com
DOCS_URL=https://docs.axenstax.org
MARKETING_URL=https://axenstax.com
CORS_ORIGINS=https://play.axenstax.com
# Voice server / Games Master — REMOVED from the stack (typed beats voice for
# kids). Leave blank: the widget won't load and the CSP slots collapse. Do not
# set this unless re-introducing the voice server.
VOICE_SERVER_ORIGIN=
# Cloud save (Blossom) is permanently off on the web taster (2026-09-27 audit
# fix) — app.py no longer reads a BLOSSOM_PUBLIC_URL env var at all, so setting
# one here does nothing. Left as a comment (not a live key) so nobody re-adds
# it expecting it to do something. See app.py's _cloud_save_enabled().
# BLOSSOM_PUBLIC_URL=
# Server Nostr identity (32-byte hex). Generate on host: openssl rand -hex 32
# Blank = ephemeral (regenerated each restart, logs a warning).
NOSTR_SERVER_KEY=
# --- Internal feedback rehome (RESERVED — not yet wired) ---
# When in-game feedback becomes typed text, it'll be signed and published to a
# dedicated internal Nostr inbox instead of the (removed) voice server. Fill when
# the keys exist; until then /api/feedback returns a friendly "being rebuilt".
# FEEDBACK_NPUB=
# FEEDBACK_NSEC=
# FEEDBACK_RELAY=wss://relay.trotters.cc
